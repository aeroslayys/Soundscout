# Required runtime configuration. Replace placeholders; never commit the real .env.
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
# Optional PEM CA file path mounted read-only into the backend container.
DATABASE_SSL_CA=
JWT_SECRET=
CORS_ORIGIN=https://your-frontend.example

# Default to no forwarded-IP trust; use 1 only when backend is private behind nginx.
TRUST_PROXY_HOPS=0

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_EMAIL_REQUEST_LIMIT_PER_HOUR=5
OTP_REQUEST_IP_LIMIT_PER_HOUR=20
OTP_VERIFY_IP_LIMIT_PER_15_MINUTES=60

AUDIO_MAX_CONCURRENT_UPLOADS=8
AUDIO_MAX_CONCURRENT_FFMPEG=8
AUDIO_ANALYSIS_TIMEOUT_MS=20000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=SoundScout
ADMIN_EMAIL=
PUBLIC_WEB_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
